TRAFIKOA_BASE_URL=https://api.euskadi.eus/traffic/v1.0
TRAFIKOA_API_KEY=
TRAFIKOA_INCIDENTS_PATH=/incidences/byDate/{year}/{month}/{day}
TRAFIKOA_CAMERAS_PATH=/cameras
TRAFIKOA_FLOWS_PATH=/flows/byDate/{year}/{month}/{day}
TRAFIKOA_METERS_PATH=/meters
TRAFIKOA_LEVEL_OF_SERVICE_PATH=/levelOfService
TRAFIKOA_CONGESTION_SOURCE_ID=5
TRAFIKOA_CONGESTION_MAX_FLOW_PAGES=25
CONGESTION_LOW_THRESHOLD=50
CONGESTION_HIGH_THRESHOLD=150
TRAFIKOA_TIMEOUT=20
TRAFIKOA_SAVE_RAW=true
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
BACKEND_URL=http://localhost:8000
CHROMA_PERSIST_DIR=data/vectorstore
CHROMA_COLLECTION_NAME=movilidad_urbana
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=180
RAG_TOP_K=5
